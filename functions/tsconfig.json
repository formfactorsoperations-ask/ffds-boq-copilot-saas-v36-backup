{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": false,
    "target": "es2017",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "pdf-lib": [
        "node_modules/pdf-lib"
      ]
    }
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}

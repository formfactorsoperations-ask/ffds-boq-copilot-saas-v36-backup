rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Retrieve the user's document from the users collection
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    
    // Check if user is Super Admin
    //
    // The address must be verified. The role branch can no longer be written
    // from a browser -- see users/{userId} below -- so it is only ever set by
    // the Admin SDK.
    function isSuperAdmin() {
      return (request.auth != null && request.auth.token.email == 'formfactors.operations@gmail.com' && request.auth.token.email_verified == true) || getUserData().get('role', '') == 'Super Admin';
    }

    /*
      The studio the caller works for -- and only if they work for it.

      A client's profile carries their studio's tenantId too, because
      createClientLogin records who issued the login. Every tenant check below
      used to compare that field alone, so a signed-in client passed all of
      them: they could list the studio's projects, its item bank with rates,
      its settings and every subcollection under organizations/{tenant}.
      A client is contained by projectIds and portalView, never by tenant.
    */
    /*
      A Designer is left out too. They may read their studio's projects and
      change drawings, nothing else, so they are granted exactly that further
      down (isTenantDesigner) instead of every write the tenant check allows.

      So are the other roles limited to assigned projects: Client Relations,
      Site Supervisor and Vendor. Each reads the copy of an assigned project
      the server makes for it (teamView, below) and the records named for it,
      never the project document, which carries every rate and margin.
    */
    function getUserTenantId() {
      let u = getUserData();
      return !(u.get('role', '') in ['Client', 'Designer', 'Client Relations', 'Site Supervisor', 'Vendor']) ? u.get('tenantId', null) : null;
    }

    /*
      Client Relations ('ops') or a Site Supervisor ('site') on THIS project,
      by the server's copy for their role (functions/src/teamView.ts), which
      lists the emails assigned to it.
    */
    function teamViewPath(projectId, kind) {
      return /databases/$(database)/documents/projects/$(projectId)/teamView/$(kind);
    }
    function teamRoleOf(kind) {
      return kind == 'ops' ? 'Client Relations' : (kind == 'site' ? 'Site Supervisor' : '');
    }
    function isAssignedTeam(tenantId, projectId, kind) {
      let u = getUserData();
      return isAuthenticated() && kind in ['ops', 'site']
        && u.get('role', '') == teamRoleOf(kind)
        && tenantId != null && u.get('tenantId', '') == tenantId
        && request.auth.token.email is string
        && exists(teamViewPath(projectId, kind))
        && get(teamViewPath(projectId, kind)).data.tenantId == tenantId
        && request.auth.token.email.lower() in get(teamViewPath(projectId, kind)).data.get('members', []);
    }
    /* The kind of copy the caller's role reads, or '' for a role that reads the project itself. */
    function myTeamKind() {
      let r = getUserData().get('role', '');
      return r == 'Client Relations' ? 'ops' : (r == 'Site Supervisor' ? 'site' : '');
    }
    /* The studio's leads: they decide escalations (lib/opsDesk). */
    function isStudioLead() {
      return isSuperAdmin() || getUserData().get('role', '') in ['Owner', 'Admin', 'Ops Director'];
    }
    function myEmail() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    /* The project records each of these roles reads, beneath either of the project's two parents. */
    function teamMayRead(kind, sub) {
      return (kind == 'ops' && sub in ['designGate', 'decisions', 'timelinePhases', 'schedule', 'tasks', 'deliverables', 'journeySteps',
                                       'stepProgress', 'moms', 'siteVisits', 'communicationLog', 'drawingTracker', 'drawingVersions',
                                       'followUps', 'escalations', 'checklists', 'visitRequests'])
        || (kind == 'site' && sub in ['decisions', 'timelinePhases', 'schedule', 'tasks', 'siteVisits', 'drawingTracker', 'drawingVersions']);
    }

    // A Designer of this studio: reads its projects, writes only drawings.
    function isTenantDesigner(tenantId) {
      let u = getUserData();
      return isAuthenticated() && u.get('role', '') == 'Designer'
        && tenantId != null && u.get('tenantId', '') == tenantId;
    }

    /*
      A Designer on THIS project. Assignment is read from the project's
      designView, which the server keeps in step with the studio's
      projectDesigners map (functions/src/designView.ts). A Designer used to
      read every project of the studio, assigned or not, the screens choosing
      which to show.
    */
    function designViewPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId)/designView/current;
    }
    function isAssignedDesigner(tenantId, projectId) {
      return isTenantDesigner(tenantId)
        && request.auth.token.email is string
        && exists(designViewPath(projectId))
        && get(designViewPath(projectId)).data.tenantId == tenantId
        && request.auth.token.email.lower() in get(designViewPath(projectId)).data.get('designers', []);
    }

    /*
      A drawing change a Designer may make: rounds, links, dates, comments and
      submitting for review. Never an approval, never a GFC release, and never
      the drawing's own definition -- those are the studio's.
    */
    function isDesignerDrawingChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['name', 'boqTriggers', 'isMandatory', 'isGapFlagged', 'companionOf', 'roomName', 'review'])
        && (!changed.hasAny(['approvedAt']) || request.resource.data.approvedAt == null)
        && (!changed.hasAny(['gfc']) || request.resource.data.gfc.status != 'issued');
    }

    /*
      DESIGN REVIEW is written by the drawingReview function and nothing else.

      A drawing's `review` summary and its reviewVersions, reviewRounds,
      reviewMarks and reviewEvents decide who approved which file. If a browser
      could write them, an approval would be whatever a console said it was.
      Rules add up -- any match that allows a write lets it through -- so every
      match that can reach a drawing asks this as well.
    */
    function isReviewRecordPath(p) {
      return p.matches('.*drawingTracker/[^/]+/review(Versions|Rounds|Marks|Events)/.*')
        /* A design meeting: what the client was shown and asked for. Written by the designMeeting function only. */
        || p.matches('.*/designMeetings/.*')
        || p.matches('.*/designLayout/.*');
    }
    function keepsReview() {
      return request.resource == null
        || request.resource.data.get('review', null) == (resource == null ? null : resource.data.get('review', null));
    }
    function reviewUntouched(p) {
      return !isReviewRecordPath(p) && (!p.matches('.*drawingTracker/[^/]+') || keepsReview());
    }

    /*
      Approving minutes in the new format (lib/minutes.ts, `format: 2`) is a
      lead's: only an Owner, Admin or Ops Director may put a name on "approved
      by", or move the minutes to approved. Everyone else on the staff writes
      minutes as before, and older minutes are untouched by this.
    */
    function minutesApprovalOk(p) {
      return !p.matches('(.*/)?moms/[^/]+') || request.resource == null || isStudioLead()
        || (request.resource.data.get('format', 0) != 2 && (resource == null || resource.data.get('format', 0) != 2))
        || (request.resource.data.get('approvedBy', null) == (resource == null ? null : resource.data.get('approvedBy', null))
            && (!(request.resource.data.get('status', '') == 'finalised'
                  && (resource == null || resource.data.get('status', '') != 'finalised'))
                /* Internal and vendor meetings need no approval: anyone on the staff saves them to the log. */
                || (isLogOnlyMeeting(request.resource.data.get('meetingType', ''))
                    && (resource == null || resource.data.get('meetingType', '') == request.resource.data.get('meetingType', '')))));
    }
    function isLogOnlyMeeting(t) {
      return t in ['internal_meeting', 'vendor_meeting', 'internal', 'vendor', 'internal_review', 'contractor_meeting'];
    }

    // Check if the user's tenant ID matches the document's tenant ID
    function isSameTenant(docTenantId) {
      let t = getUserTenantId();
      return t != null && t == docTenantId;
    }

    // A portal client, on one of their own projects.
    function isProjectClient(orgId, projectId) {
      let u = getUserData();
      return isAuthenticated() && u.get('role', '') == 'Client'
        && u.get('tenantId', '') == orgId
        && projectId in u.get('projectIds', []);
    }

    // Compatibility for legacy FFDS workflow (demo-tenant-01)
    function isLegacyFFDS() {
      return getUserTenantId() == 'demo-tenant-01';
    }

    // Future-ready RBAC stub - can be expanded to check roles like 'admin', 'editor'
    // Currently returns true if the user is part of the tenant
    function hasRole(role) {
      // In the future, check (getUserData().role == role || getUserData().roles.hasAny([role]))
      return true; 
    }

    // ========================================================================
    // USERS & ORGANIZATIONS
    // ========================================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());

      /*
        A profile may be started from the browser, but never with privilege.

        This used to accept any fields, and the studio sign-in wrote
        `tenantId: 'demo-tenant-01', role: 'Admin'` for anyone who had never
        signed in before -- so a Google account was enough to be an Admin, and
        a console was enough to name any tenant at all. Studio membership is now
        settled by the syncStudioAccess function from the studio's own team
        list, and client logins by createClientLogin; both use the Admin SDK.
      */
      allow create: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         !request.resource.data.keys().hasAny(['role', 'roles', 'tenantId', 'projectIds']));

      /*
        Self-service updates may not touch privilege.

        `role` (and `roles`, all of a person's roles), `tenantId` and `projectIds` decide which app you get and which
        projects you can open. With a blanket write on your own document, a
        client could set their own role to Admin and walk into the studio app.
        Those three are written by the Admin SDK only, which bypasses rules;
        everything a user legitimately changes about themselves is listed here.
      */
      allow update: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['mustChangePassword', 'updatedAt', 'displayName', 'lastSeenAt', 'email', 'lastProjectTabs', 'attentionState']));
        /*
          There used to be a third branch here letting any non-client write
          their own `role`, so the studio sign-in could copy it from the team
          list. It also let them write "Super Admin", which isSuperAdmin()
          honours in every tenant. The copy is made by syncStudioAccess now.
        */

      allow delete: if isSuperAdmin();
    }

    match /organizations/{orgId} {
      /*
        The studio profile carries its team list -- names, emails, roles -- and
        was readable by anyone. Its members and its own clients read it; the
        portal link's sign-in door gets only the name and logo, through the
        portalDoor function.
      */
      /*
        Not its clients any more: the record carries the team list (names,
        emails, roles) and which Designer works on which project. A client's
        portal copy carries the studio's name, logo and contact details.
      */
      allow read: if isAuthenticated() && (
          (getUserData().get('tenantId', '') == orgId && getUserData().get('role', '') != 'Client') || isSuperAdmin()
      );
      /*
        A new studio is created by the platform owner. "Create it if it does
        not exist yet" let anyone mint a tenant and name themselves its team.

        The team list decides who syncStudioAccess lets in and as what, and
        projectDesigners decides which projects each Designer sees, so only a
        studio's senior roles may change either.
      */
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
          isSameTenant(orgId) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['team', 'projectDesigners', 'opsDesk', 'peopleDesk']) ||
           getUserData().get('role', '') in ['Owner', 'Admin', 'Ops Director'])
      );
      allow delete: if isSuperAdmin();
      
      match /settings/{settingId} {
         allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin() || isTenantDesigner(orgId)
           || (getUserData().get('tenantId', '') == orgId && myTeamKind() != ''));
         allow write: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
            && (getUserData().role == 'Owner' || isSuperAdmin());
      }

      match /projects/{projectId} {
         match /boqItems/{itemId} {
           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           // No hard deletes
           allow delete: if false;

           allow update: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
             // Viewer check
             && (getUserData().role != 'Viewer')
             // Enforce append-only array for statusHistory
             && (!request.resource.data.keys().hasAll(['statusHistory']) || 
                 !resource.data.keys().hasAll(['statusHistory']) || 
                 request.resource.data.statusHistory.size() >= resource.data.statusHistory.size())
             // Designer logic check
             && (
                (getUserData().role == 'Designer' && request.resource.data.boqStatus != resource.data.boqStatus) 
                  ? (request.resource.data.boqStatus in ['included_ffds_scope', 'pending_finalisation', 'on_hold'])
                  : true // If not Designer, or not changing boqStatus, bypass
             );
         }

         match /boqVersions/{versionId} {
           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           // Creation is handled by Cloud Functions, but if we allow it from client:
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow update, delete: if false; // Immutable once created
         }

         match /bookingPacks/{packId} {
           /*
             Studio only. This was readable by anyone, and anyone could mark a
             pack approved, for a public approval page that no longer exists --
             nothing in the app renders /booking-approval/ any more.
           */
           allow read, create, update, delete: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
         }

         match /drawingTracker/{drawingId} {
           /* The Designer's one place to work: see isDesignerDrawingChange. On their own projects only. */
           allow read: if isAssignedDesigner(orgId, projectId);
           allow update: if isAssignedDesigner(orgId, projectId) && isDesignerDrawingChange();
           match /revisions/{revisionId} {
             allow read, create: if isAssignedDesigner(orgId, projectId);
           }
           /* Design Review records: read by the studio (the catch-all below) and the assigned Designer; written by the function only. */
           match /{reviewSub}/{reviewDoc} {
             allow read: if reviewSub in ['reviewVersions', 'reviewRounds', 'reviewMarks', 'reviewEvents']
               && isAssignedDesigner(orgId, projectId);
           }

           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin()) && !('review' in request.resource.data);
           allow delete: if false;
           allow update: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
             && keepsReview()
             && (getUserData().role != 'Viewer')
             && (
               // Owner and Designer of the OWNING org may Issue GFC
               (request.resource.data.gfc.status == 'issued' && (!('gfc' in resource.data) || resource.data.gfc.status != 'issued'))
               ? (getUserData().role in ['Owner', 'Designer', 'Admin', 'Ops Director', 'Super Admin'] || isSuperAdmin() || isLegacyFFDS())
               : true
             );
         }

         /*
           The programme the Timeline draws (dbService.getSchedule): stages,
           dates, holds and the target handover; no prices. An assigned
           Designer reads it, as Client Relations and a Site Supervisor do
           through teamMayRead. Without it they saw a programme rebuilt from
           their own copy, which has no BOQ, so no trades and no handover.
         */
         match /schedule/{scheduleId} {
           allow read: if isAssignedDesigner(orgId, projectId);
         }

         match /drawingVersions/{versionId} {
           allow read: if isAssignedDesigner(orgId, projectId);
           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
             && (getUserData().role in ['Owner', 'Designer', 'Admin', 'Ops Director', 'Super Admin'] || isSuperAdmin() || isLegacyFFDS());
           allow update, delete: if false; // Immutability
         }

         /*
           A Designer used to read this -- the studio's copy of the whole
           project, money included -- and everything under it. They read the
           project's designView instead; drawings are granted above.
         */

         allow read, create, delete: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
         allow update: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
           && (getUserData().role != 'Viewer')
           && (
              (request.resource.data.executionData != null && 
               (!('executionData' in resource.data) || request.resource.data.executionData.bundles != resource.data.executionData.bundles))
              ? (getUserData().role in ['Owner', 'Admin', 'Ops Director', 'Super Admin'] || isSuperAdmin() || isLegacyFFDS())
              : true
           )
           && (
              (request.resource.data.engagement != resource.data.engagement)
              ? (getUserData().role == 'Owner' || isSuperAdmin())
              : true
           );
      }
      
      /*
        What a portal client reads beneath the studio's copy of their project.

        The portal listens to these two directly. It used to get through on the
        tenant check above, which a client passed for every project the studio
        had; this names the one project, from their own profile.
      */
      /*
        Only the meetings the client was part of.

        Internal and vendor meetings are the studio's own: their notes, MoMs
        and decisions were readable by the client straight from the database,
        hidden only by the portal screen's guess from the title. Now the rule
        decides, by the meeting's type. A meeting with no type, or any type
        not listed here, stays with the studio. The portal asks for these types
        by name -- a rule that reads the document cannot filter a query, so an
        open query is refused outright.
      */
      function isClientMeetingType(t) {
        return t in ['client_meeting', 'site_visit', 'measurement_survey', 'client'];
      }
      /*
        Minutes the studio has issued. A draft, or minutes waiting for a lead
        to review them, were readable by the client straight from the
        database -- raw notes, unreviewed wording, a revision in progress --
        and hidden only by the portal screen. The portal asks for these
        statuses by name (lib/meetingTypes CLIENT_MOM_STATUSES).
      */
      function isIssuedMinutes(st) {
        return st in ['finalised', 'shared', 'acknowledged', 'correction_requested'];
      }
      match /projects/{projectId}/siteVisits/{visitId} {
        allow read: if isProjectClient(orgId, projectId) &&
          isClientMeetingType(resource.data.get('type', ''));
      }
      match /projects/{projectId}/moms/{momId} {
        allow read: if isProjectClient(orgId, projectId) &&
          isClientMeetingType(resource.data.get('meetingType', '')) &&
          isIssuedMinutes(resource.data.get('status', ''));
        // From the portal a client may do one of two things to issued
        // minutes: acknowledge them (these four fields only), or ask for a
        // correction (the request and the status, nothing else). Neither on a
        // draft, and not while a correction they asked for is still open.
        allow update: if isProjectClient(orgId, projectId) &&
          isClientMeetingType(resource.data.get('meetingType', '')) &&
          resource.data.get('status', '') in ['finalised', 'shared'] && (
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'ackChannel']) &&
             request.resource.data.status == 'acknowledged') ||
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'correctionRequest']) &&
             request.resource.data.status == 'correction_requested' &&
             request.resource.data.correctionRequest.keys().hasOnly(['text', 'by', 'at', 'lines']) &&
             request.resource.data.correctionRequest.text is string &&
             request.resource.data.correctionRequest.text.size() > 0 &&
             request.resource.data.correctionRequest.text.size() <= 2000 &&
             // New minutes: the lines the client marked, each with what is wrong (lib/minutes.ts).
             request.resource.data.correctionRequest.get('lines', []) is list &&
             request.resource.data.correctionRequest.get('lines', []).size() <= 50)
          );
      }

    match /weeklyReports/{reportId} {
      /* A published report used to be readable by anyone, signed in or not. Clients get theirs in the portal. */
      allow read: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin());
      allow create: if isAuthenticated() && (isSameTenant(request.resource.data.tenantId) || isSuperAdmin())
                    && (getUserData().role in ['Owner', 'Admin', 'Super Admin']);
      allow update: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin())
                    && (getUserData().role in ['Owner', 'Admin', 'Super Admin'])
                    && (
                      resource.data.status != 'published' || 
                      (request.resource.data.status == 'superseded' || request.resource.data.supersededBy != null)
                    );
      allow delete: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin())
                    && (getUserData().role in ['Owner', 'Admin', 'Super Admin'])
                    && resource.data.status != 'published';
    }

    /*
      THE MINUTES REVIEW STEP. Client Relations writes minutes on an assigned
      project and sends them for approval; they never finalise or share them,
      so nothing they write reaches a client until a lead has approved it.
      The studio's own staff are unchanged (the catch-all below).
    */
    match /projects/{projectId}/moms/{momId} {
      allow create: if isAssignedTeam(orgId, projectId, 'ops')
        && request.resource.data.get('status', '') in ['draft', 'pending_review']
        && !('approvedBy' in request.resource.data)
        /* Proposal and negotiation minutes talk money: a lead writes them (lib/minutes MEETING_TEMPLATES). */
        && !(request.resource.data.get('template', '') in ['proposal', 'negotiation']);
      allow update: if isAssignedTeam(orgId, projectId, 'ops') && (
        (resource.data.get('status', '') in ['draft', 'pending_review']
          && request.resource.data.get('status', '') in ['draft', 'pending_review']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvedBy']))
        ||
        /*
          New minutes (lib/minutes.ts): once a lead has approved them, Client
          Relations sends them -- the status moves to shared and the send is
          recorded, nothing else. The record of steps only grows.
        */
        (resource.data.get('format', 0) == 2
          && resource.data.get('status', '') in ['finalised', 'shared']
          && request.resource.data.get('status', '') == 'shared'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'sharedAt', 'sentAt', 'sentBy', 'emailedAt', 'emailedTo', 'shareToken', 'trail', 'updatedAt', 'clientVisibility'])
          && request.resource.data.get('clientVisibility', {}).get('state', 'published') == 'published'
          && request.resource.data.get('trail', []).size() >= resource.data.get('trail', []).size())
        ||
        /*
          An internal or vendor meeting needs no approval and never reaches
          the client: Client Relations saves it straight to the log.
        */
        (resource.data.get('format', 0) == 2
          && resource.data.get('status', '') == 'draft'
          && request.resource.data.get('status', '') == 'finalised'
          && isLogOnlyMeeting(resource.data.get('meetingType', ''))
          && request.resource.data.get('meetingType', '') == resource.data.get('meetingType', '')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvedBy']))
        ||
        /*
          ...and answers a client's correction with a revision, written beside
          the minutes the client has, up to sending it for approval. The
          client's copy, its status and its approval stay as they are.
        */
        (resource.data.get('format', 0) == 2
          && resource.data.get('status', '') == 'correction_requested'
          && request.resource.data.get('status', '') == 'correction_requested'
          && resource.data.get('revisionStage', 'draft') == 'draft'
          && request.resource.data.get('revisionStage', '') in ['draft', 'pending_review']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingRevision', 'revisionStage', 'trail', 'updatedAt', 'reviewTenantId', 'reviewProjectId',
                         'reviewProjectName', 'reviewRequestedBy', 'reviewRequestedAt'])
          && request.resource.data.get('trail', []).size() >= resource.data.get('trail', []).size())
      );
    }
    /*
      The studio's own lines of new minutes ("studio only", lib/minutes
      splitPrivate), kept beside them. No client rule reaches here.
    */
    match /projects/{projectId}/moms/{momId}/private/{docId} {
      allow read, write: if isAssignedTeam(orgId, projectId, 'ops');
    }
    /* The numbering the minutes take (services/momService). */
    match /sequences/{seqId} {
      allow read, write: if seqId == 'moms' && getUserData().get('tenantId', '') == orgId && myTeamKind() == 'ops';
    }

    /* Client Relations and Site Supervisors, on an assigned project: the records teamMayRead names. */
    match /projects/{projectId}/{teamSub}/{teamDoc=**} {
      allow read: if teamMayRead(myTeamKind(), teamSub) && isAssignedTeam(orgId, projectId, myTeamKind());
    }

    /*
      Everything else beneath the studio, for its own staff.

      `{collectionId}` first, so this needs at least one segment below the
      studio. A bare `{document=**}` also matches zero segments in rules v2 --
      that is, organizations/{orgId} itself -- which quietly let every member,
      and every client, rewrite the studio profile and its team list whatever
      the rules above said.
    */
    match /{collectionId}/{document=**} {
         allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
         allow write: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
           && reviewUntouched(string(document)) && minutesApprovalOk(string(document));
      }
    }

    // ========================================================================
    // CORE COLLECTIONS (Tenant-Aware)
    // ========================================================================
    
    // PROJECTS: Main Project Data
    match /projects/{projectId} {
      /*
        This was `allow read: if true` -- every project of every studio, with
        its rates, margins, client contacts and internal notes, readable by
        anyone holding the public web config. Nothing needs that any more:
        clients read the stripped portalView below, and the portal link's
        sign-in door asks the portalDoor function for the studio's name.
      */
      /* Not a Designer: the document is the whole project, money included. See designView below. */
      allow read: if isAuthenticated() && (
        isSameTenant(resource.data.tenantId) ||
        (isLegacyFFDS() && !('tenantId' in resource.data)) ||
        isSuperAdmin()
      );

      /*
        THE DESIGNER'S COPY: the project without its money, written only by
        the server (functions/src/designView.ts), readable by the studio and
        by the Designers assigned to the project -- one at a time, or as a
        list of exactly their own.
      */
      match /designView/{viewId} {
        allow read: if isAuthenticated() && (
          isSameTenant(resource.data.tenantId) || isSuperAdmin() ||
          (isTenantDesigner(resource.data.tenantId) && request.auth.token.email is string
            && request.auth.token.email.lower() in resource.data.designers)
        );
        allow write: if false;
      }

      /*
        THE CLIENT RELATIONS AND SITE SUPERVISOR COPIES: written only by the
        server (functions/src/teamView.ts), readable by the studio and by the
        people of the matching role assigned to the project.
      */
      match /teamView/{kind} {
        allow read: if isAuthenticated() && (
          isSameTenant(resource.data.tenantId) || isSuperAdmin() ||
          isAssignedTeam(resource.data.tenantId, projectId, kind)
        );
        allow write: if false;
      }

      /* Client Relations and Site Supervisors: the records teamMayRead names, on an assigned project. */
      match /{teamSub}/{teamDoc=**} {
        allow read: if teamMayRead(myTeamKind(), teamSub)
          && isAssignedTeam(get(teamViewPath(projectId, myTeamKind())).data.tenantId, projectId, myTeamKind());
      }

      /*
        What a Designer reads beneath an assigned project, by name: the design
        gate, decisions and the programme. Everything else under a project --
        the priced tier BOQs, the agreement, payment requests, margins, scope
        additions, the client's portal copy -- stays with the studio.
      */
      match /{designerSub}/{designerDoc=**} {
        allow read: if designerSub in ['designGate', 'decisions', 'timelinePhases', 'tasks', 'deliverables', 'journeySteps', 'stepProgress']
          && isAssignedDesigner(get(designViewPath(projectId)).data.tenantId, projectId);
      }

      /*
        Writes belong to the studio that owns the project.

        The second clause here used to read:

          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['context', 'lastModified', 'isCompressed', 'compressedData']))

        with no authentication at all, so that a portal client could record a
        signature. But `context` is the entire project — every rate, every
        internal note, every unpublished draft, the portal access token — and
        `compressedData` is that same context as a blob. Anyone who knew a
        project id could replace all of it, and no narrower version of the rule
        was possible: security rules cannot see inside a compressed field.

        Client sign-offs, queries, disputes, document views and selection
        confirmations now go through the `submitClientAction` callable, which
        checks the caller's own users/{uid} record and applies one action from a
        closed set. The client never writes this document.
      */
      /*
        The project must already be the caller's studio's, as well as stay so.
        Only the new value was checked, so another studio's admin who knew a
        project's id -- and ids are in every portal link -- could rewrite it
        and claim it by setting tenantId to their own.
      */
      allow update: if isAuthenticated() && (
        (isSameTenant(request.resource.data.tenantId) &&
          (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)))) ||
        isSuperAdmin()
      );

      // CREATE: Document payload must match user's tenantId
      allow create: if isAuthenticated() && (isSameTenant(request.resource.data.tenantId) || isSuperAdmin());
      
      // DELETE: Can only delete if they had read access to it
      allow delete: if isAuthenticated() && (
        isSameTenant(resource.data.tenantId) ||
        (isLegacyFFDS() && !('tenantId' in resource.data)) ||
        isSuperAdmin()
      );

      /*
        PORTAL VIEW — the published, client-safe projection.

        This is what a signed-in client reads instead of the project document.
        buildPortalView has already stripped rates, margins, unpublished items
        and the access token, so what is not published is not merely hidden in
        the UI -- it is never sent. Access is by the reader's own profile:
        the project must be listed on their users/{uid}.projectIds.
      */
      match /portalView/{viewId} {
        allow read: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin() ||
          (projectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.projectIds)
        );
        allow write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin()
        );
      }

      /*
        BOQ line items for each version of the project's scope.

        Moved out of the project document because they are the bulk of it — on a
        live project, 443KB of a 699KB payload against Firestore's 1 MiB limit —
        and the save used to stay under that limit by deleting superseded
        versions outright.

        Studio-side only. This is the priced BOQ with the studio's own line
        detail; what a client may see goes through portalView, which carries
        sell rates and nothing behind them. A portal client's projectIds grant
        them nothing here, deliberately.
      */
      /*
        The engagement record: locked terms snapshot, payment structure, the
        agreement's own history. Moved out of the project document because it is
        the largest single field on it — 359KB on a live project against a 1 MiB
        limit — and a project that outgrows that limit stops syncing entirely.

        Studio-side only. A client reads their terms through portalView, which
        carries the slice the documents are rendered from and nothing else.
      */
      match /engagement/{docId} {
        allow read, write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin()
        );
      }

      match /tierBoq/{tierId} {
        allow read, write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin()
        );
      }

      match /selections/{selectionId} {
        allow read, write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
          isSuperAdmin()
        );
      }

      // DECISIONS (Nested Collection)
      /*
        Studio-side project subcollections.

        Firestore rules do not cascade: `match /projects/{projectId}` granting
        read does nothing for the collections beneath it, and each of these had
        no match block of its own, so every read was denied. The app's own
        listeners pass no error callback, so the denial surfaced as a screen
        that says "Loading..." forever rather than as an error — the
        communication tracker was stuck on exactly that.

        Access follows the model already used by `decisions` and `tierBoq`
        below: the reader must be signed in and belong to the tenant that owns
        the parent project. These are internal operational records — comms
        logs, site visits, tasks, margin analytics — so unlike `portalView`
        there is no client-facing path and no unauthenticated branch.
      */
      function ownsParentProject() {
        return isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
          isSuperAdmin()
        );
      }

      /*
        THE FOLLOW-UP LOG AND ESCALATIONS (lib/opsDesk.ts).

        Written by the studio's staff and by Client Relations on an assigned
        project, each line in their own name and marked as written by hand.
        A line is never edited or deleted, only its next step ticked off: it
        is the record of who told the client what, and when.

        An escalation is raised the same way and decided by a lead; the one
        who raised it closes it once acted on. The daily check raises some by
        itself, through the server.
      */
      function parentTenant() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId;
      }
      function mayWriteOps() {
        return (ownsParentProject() && getUserData().get('role', '') != 'Viewer')
          || isAssignedTeam(parentTenant(), projectId, 'ops');
      }
      match /followUps/{fid} {
        allow read: if ownsParentProject();
        allow create: if mayWriteOps()
          && request.resource.data.keys().hasOnly(['tenantId', 'projectId', 'projectName', 'at', 'by', 'byName', 'channel',
               'note', 'subject', 'outcome', 'next', 'nextDone', 'manual'])
          && request.resource.data.tenantId == parentTenant()
          && request.resource.data.projectId == projectId
          && request.resource.data.by == myEmail()
          && request.resource.data.manual == true
          && request.resource.data.nextDone == false
          && request.resource.data.channel in ['call', 'whatsapp', 'email', 'meeting', 'other']
          && request.resource.data.outcome in ['reminded', 'no_answer', 'replied', 'promised', 'info']
          && request.resource.data.note is string && request.resource.data.note.size() <= 2000;
        allow update: if mayWriteOps()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextDone', 'nextDoneAt', 'nextDoneBy'])
          && request.resource.data.nextDoneBy == myEmail();
        allow delete: if false;
      }
      match /escalations/{eid} {
        allow read: if ownsParentProject();
        allow create: if mayWriteOps()
          && request.resource.data.keys().hasOnly(['tenantId', 'projectId', 'projectName', 'title', 'detail', 'category',
               'subjectKey', 'raisedBy', 'raisedByName', 'raisedAt', 'auto', 'status'])
          && request.resource.data.tenantId == parentTenant()
          && request.resource.data.projectId == projectId
          && request.resource.data.raisedBy == myEmail()
          && request.resource.data.auto == false
          && request.resource.data.status == 'open'
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.detail is string && request.resource.data.detail.size() <= 2000;
        allow update: if (
            ownsParentProject() && isStudioLead()
            && resource.data.status == 'open' && request.resource.data.status == 'decided'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'decidedBy', 'decidedByName', 'decidedAt'])
            && request.resource.data.decidedBy == myEmail()
            && request.resource.data.decision is string && request.resource.data.decision.size() > 0 && request.resource.data.decision.size() <= 2000
          ) || (
            (resource.data.raisedBy == myEmail() || resource.data.get('auto', false) == true || (ownsParentProject() && isStudioLead()))
            && mayWriteOps()
            && resource.data.status == 'decided' && request.resource.data.status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt'])
          );
        allow delete: if false;
      }

      /*
        CLIENT CARE (lib/clientCare.ts).

        Checklists -- onboarding, handover, and the documents the studio needs
        from the client -- are worked by the same people as the follow-up
        log, each change in their own name. Only a lead marks one complete,
        or reopens it; once complete, only a lead changes it.
      */
      match /checklists/{kind} {
        allow read: if ownsParentProject();
        allow create, update: if mayWriteOps()
          && kind in ['onboarding', 'handover', 'documents']
          && request.resource.data.keys().hasOnly(['tenantId', 'projectId', 'projectName', 'kind', 'items',
               'completedAt', 'completedBy', 'completedByName', 'updatedAt', 'updatedBy'])
          && request.resource.data.tenantId == parentTenant()
          && request.resource.data.projectId == projectId
          && request.resource.data.kind == kind
          && request.resource.data.items is list && request.resource.data.items.size() <= 60
          && request.resource.data.updatedBy == myEmail()
          && (resource == null
                ? (request.resource.data.get('completedAt', null) == null || isStudioLead())
                : ((resource.data.get('completedAt', null) == null || isStudioLead())
                   && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedAt', 'completedBy', 'completedByName'])
                       || (isStudioLead() && request.resource.data.get('completedBy', null) in [myEmail(), null]))));
        allow delete: if false;
      }

      /*
        Meeting and site visit requests: requested, confirmed, rescheduled
        (a new time put to the client), then done or cancelled. Each change
        adds one line to the history, which is never rewritten.
      */
      function visitMove(a, b) {
        return (a == 'requested' && b in ['requested', 'confirmed', 'cancelled'])
          || (a == 'confirmed' && b in ['rescheduled', 'done', 'cancelled'])
          || (a == 'rescheduled' && b in ['rescheduled', 'confirmed', 'cancelled']);
      }
      match /visitRequests/{vid} {
        allow read: if ownsParentProject();
        allow create: if mayWriteOps()
          && request.resource.data.keys().hasOnly(['tenantId', 'projectId', 'projectName', 'kind', 'mode', 'purpose', 'requestedBy',
               'status', 'slot', 'reschedules', 'history', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy'])
          && request.resource.data.tenantId == parentTenant()
          && request.resource.data.projectId == projectId
          && request.resource.data.createdBy == myEmail()
          && request.resource.data.updatedBy == myEmail()
          && request.resource.data.kind in ['meeting', 'site_visit', 'measurement']
          && request.resource.data.mode in ['in_person', 'video', 'call']
          && request.resource.data.requestedBy in ['client', 'studio']
          && request.resource.data.status in ['requested', 'confirmed']
          && request.resource.data.reschedules == 0
          && request.resource.data.purpose is string && request.resource.data.purpose.size() <= 300
          && request.resource.data.history is list && request.resource.data.history.size() == 1;
        allow update: if mayWriteOps()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'slot', 'reschedules', 'history', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == myEmail()
          && visitMove(resource.data.status, request.resource.data.status)
          && request.resource.data.reschedules >= resource.data.reschedules
          && request.resource.data.history is list
          && request.resource.data.history.size() == resource.data.history.size() + 1;
        allow delete: if false;
      }

      match /communicationLog/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /deliverables/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /designGate/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /journeySteps/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /liveFeed/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /marginAnalytics/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /moms/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /paymentRequests/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /scopeAdditions/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /siteVisits/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /stepProgress/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /tasks/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /timelinePhases/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /decisions/{decisionId} {
        allow read: if (isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        )) ||
                       /*
                         Only what has been released to them. A draft decision is
                         the studio's working note -- who was on site, the cost
                         being weighed -- and the portal never shows one; the
                         client could still read it from the database.
                       */
                       (isDecisionClient() &&
                        resource.data.get('status', '') in ['notified', 'drawing_pending', 'drawing_sent', 'signed', 'disputed']);

        /*
          The portal client approves or queries a decision on their own
          project (decisionsService.recordClientSignoff). That used to pass the
          tenant check above, because a client's profile carries the studio's
          tenantId; clients no longer pass it, so they are named here -- their
          project only, and only the three fields a response writes.
        */
        function isDecisionClient() {
          let u = getUserData();
          return isAuthenticated() && u.get('role', '') == 'Client'
            && projectId in u.get('projectIds', [])
            && u.get('tenantId', '') == get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId;
        }
        allow update: if isDecisionClient()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'discussion', 'signoff'])
          && request.resource.data.status in ['signed', 'disputed'];

        allow create: if isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        );

        allow update: if (isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        ));
        /*
          A signed-out branch used to sit on both read and update here, for the
          emailed decision sign-off page. That page was removed and decisions
          are answered in the portal, by isDecisionClient above.
        */

        allow delete: if isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        );
      }
    }

    // MULTI-TENANT MASTER DATA (Item Bank, Templates, Rate Library)
    // Legacy system used hardcoded names like 'item_bank'
    // New system uses 'item_bank_{tenantId}'
    match /master_data/{docId} {
      allow read, write: if isAuthenticated() && (
        (isLegacyFFDS() && (docId == 'item_bank' || docId == 'draft_item_bank' || docId == 'templates')) ||
        (docId == 'item_bank_' + getUserTenantId()) ||
        (docId == 'draft_item_bank_' + getUserTenantId()) ||
        (docId == 'templates_' + getUserTenantId()) ||
        isSuperAdmin()
      );
    }
    
    /*
      publicProposals was readable by anyone and nothing uses it now: it falls
      to the deny-all at the end. studioSettings was readable by anyone too;
      only the studio's own screens read it.
    */
    match /studioSettings/{settingId} {
      allow read: if isAuthenticated() && (settingId == getUserTenantId() || isSuperAdmin());
      allow write: if isAuthenticated() && (settingId == getUserTenantId() || isSuperAdmin());
    }

    /*
      Zoho Books add-in (optional; see functions/src/zohoBooks.ts).

      A studio's Zoho client secret and refresh token live in
      zohoBooksConnections, and zohoInvoiceLinks records which Zoho draft
      belongs to which milestone. Only the zohoBooks function reads or writes
      either, through the Admin SDK, which bypasses these rules. No browser
      gets in, including the studio's own Owner: a credential that can reach
      their books must not be readable from a console. Closed by name rather
      than left to the deny-all below, so a later broad rule cannot open them.
    */
    match /zohoBooksConnections/{tenantId} {
      allow read, write: if false;
    }
    match /zohoInvoiceLinks/{linkId} {
      allow read, write: if false;
    }

    match /studios/{studioId} {
      allow read: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
      allow write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
      
      match /settings/{docId} {
        allow read: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin() || isTenantDesigner(studioId));
        allow write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
      }
      match /projects/{projectId} {
         allow read: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
         allow write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
         match /{document=**} {
            allow read, write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
         }
         /*
           The programme lives here too (hooks/useTimelinePhases, useStepProgress),
           so the same grants as beneath projects/{projectId}: an assigned
           Designer reads the design records, Client Relations and a Site
           Supervisor what teamMayRead names. Never payment requests. Without
           this the Timeline tab was refused to them and span forever.
         */
         match /{sub}/{subDoc=**} {
            allow read: if (sub in ['designGate', 'decisions', 'timelinePhases', 'tasks', 'deliverables', 'journeySteps', 'stepProgress']
                              && isAssignedDesigner(studioId, projectId))
                        || (teamMayRead(myTeamKind(), sub) && isAssignedTeam(studioId, projectId, myTeamKind()));
         }
      }
    }

    // ========================================================================
    // FUTURE-READY COLLECTIONS (For upcoming modularization)
    // Preparing schema for boqItems, proposals, client_outputs, rate_library, execution_data
    // ========================================================================

    match /boqItems/{itemId} {
      allow read: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)));
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)));
    }

    match /proposals/{proposalId} {
      allow read: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)));
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId) && hasRole('editor');
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }

    match /client_outputs/{outputId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }

    match /rate_library/{rateId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId) && hasRole('admin');
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId) && hasRole('admin');
    }

    match /execution_data/{execId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }

    /*
      A Designer's list of their own projects: every designView naming them,
      across projects. The query has to say so (tenantId == their studio,
      designers array-contains their email); one that does not is refused.
    */
    /*
      The Design Head's review inbox: every drawing of her studio that has a
      review, across projects, in one query. The query must name the studio
      (review.orgId == hers); the function writes that field, never a browser.
    */
    match /{path=**}/drawingTracker/{drawingId} {
      allow read: if isAuthenticated() && resource.data.get('review', null) != null
        && (isSameTenant(resource.data.review.get('orgId', '')) || isSuperAdmin());
    }

    /*
      Client Relations' and a Site Supervisor's list of their own projects:
      every copy of their kind naming them. The query must say so (tenantId,
      kind, members array-contains their email).
    */
    match /{path=**}/teamView/{kind} {
      allow list: if isAuthenticated()
        && getUserData().get('role', '') == teamRoleOf(resource.data.kind)
        && getUserData().get('tenantId', '') == resource.data.tenantId
        && request.auth.token.email is string
        && request.auth.token.email.lower() in resource.data.members;
    }

    /*
      The Ops Desk for the studio's own staff: every follow-up and escalation
      of their studio, and the minutes waiting for approval, in one query each.
      The query must name the studio.
    */
    match /{path=**}/followUps/{fid} {
      allow list: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }
    match /{path=**}/escalations/{eid} {
      allow list: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin());
    }
    match /{path=**}/moms/{momId} {
      allow list: if isAuthenticated()
        && (resource.data.get('status', '') == 'pending_review' || resource.data.get('revisionStage', '') == 'pending_review')
        && isSameTenant(resource.data.get('reviewTenantId', ''));
    }

    match /{path=**}/designView/{viewId} {
      allow list: if isAuthenticated() && isTenantDesigner(resource.data.tenantId)
        && request.auth.token.email is string
        && request.auth.token.email.lower() in resource.data.designers;
    }

    // ========================================================================
    // FALLBACK
    // ========================================================================

    /*
      People (lib/peopleDesk.ts): attendance, leave requests and the journal of
      every change. Read and written only by the Cloud Functions
      (functions/src/peopleDesk.ts), which scope what each person sees.
    */
    match /peopleDesk/{document=**} {
      allow read, write: if false;
    }

    // Catch-all to deny unspecified collections to prevent accidental data leaks
    match /{document=**} {
      allow read, write: if false; 
    }
    /*
      There was a collection-group rule here letting anyone read any decision
      with an unexpired sign-off token. A query that asked for exactly that --
      every decision whose token has not expired -- satisfied it, so the whole
      platform's open decisions could be listed without signing in. It served
      the standalone decision sign-off page, which was removed; decisions are
      approved in the portal, under the per-project rules above.
    */
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Retrieve the user's document from the users collection
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    
    // Check if user is Super Admin
    //
    // The address must be verified. The role branch can no longer be written
    // from a browser -- see users/{userId} below -- so it is only ever set by
    // the Admin SDK.
    function isSuperAdmin() {
      return (request.auth != null && request.auth.token.email == 'formfactors.operations@gmail.com' && request.auth.token.email_verified == true) || getUserData().get('role', '') == 'Super Admin';
    }

    /*
      The studio the caller works for -- and only if they work for it.

      A client's profile carries their studio's tenantId too, because
      createClientLogin records who issued the login. Every tenant check below
      used to compare that field alone, so a signed-in client passed all of
      them: they could list the studio's projects, its item bank with rates,
      its settings and every subcollection under organizations/{tenant}.
      A client is contained by projectIds and portalView, never by tenant.
    */
    /*
      A Designer is left out too. They may read their studio's projects and
      change drawings, nothing else, so they are granted exactly that further
      down (isTenantDesigner) instead of every write the tenant check allows.
    */
    function getUserTenantId() {
      let u = getUserData();
      return !(u.get('role', '') in ['Client', 'Designer']) ? u.get('tenantId', null) : null;
    }

    // A Designer of this studio: reads its projects, writes only drawings.
    function isTenantDesigner(tenantId) {
      let u = getUserData();
      return isAuthenticated() && u.get('role', '') == 'Designer'
        && tenantId != null && u.get('tenantId', '') == tenantId;
    }

    /*
      A drawing change a Designer may make: rounds, links, dates, comments and
      submitting for review. Never an approval, never a GFC release, and never
      the drawing's own definition -- those are the studio's.
    */
    function isDesignerDrawingChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['name', 'boqTriggers', 'isMandatory', 'isGapFlagged', 'companionOf', 'roomName'])
        && (!changed.hasAny(['approvedAt']) || request.resource.data.approvedAt == null)
        && (!changed.hasAny(['gfc']) || request.resource.data.gfc.status != 'issued');
    }

    // Check if the user's tenant ID matches the document's tenant ID
    function isSameTenant(docTenantId) {
      let t = getUserTenantId();
      return t != null && t == docTenantId;
    }

    // A portal client, on one of their own projects.
    function isProjectClient(orgId, projectId) {
      let u = getUserData();
      return isAuthenticated() && u.get('role', '') == 'Client'
        && u.get('tenantId', '') == orgId
        && projectId in u.get('projectIds', []);
    }

    // Compatibility for legacy FFDS workflow (demo-tenant-01)
    function isLegacyFFDS() {
      return getUserTenantId() == 'demo-tenant-01';
    }

    // Future-ready RBAC stub - can be expanded to check roles like 'admin', 'editor'
    // Currently returns true if the user is part of the tenant
    function hasRole(role) {
      // In the future, check (getUserData().role == role || getUserData().roles.hasAny([role]))
      return true; 
    }

    // ========================================================================
    // USERS & ORGANIZATIONS
    // ========================================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());

      /*
        A profile may be started from the browser, but never with privilege.

        This used to accept any fields, and the studio sign-in wrote
        `tenantId: 'demo-tenant-01', role: 'Admin'` for anyone who had never
        signed in before -- so a Google account was enough to be an Admin, and
        a console was enough to name any tenant at all. Studio membership is now
        settled by the syncStudioAccess function from the studio's own team
        list, and client logins by createClientLogin; both use the Admin SDK.
      */
      allow create: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         !request.resource.data.keys().hasAny(['role', 'tenantId', 'projectIds']));

      /*
        Self-service updates may not touch privilege.

        `role`, `tenantId` and `projectIds` decide which app you get and which
        projects you can open. With a blanket write on your own document, a
        client could set their own role to Admin and walk into the studio app.
        Those three are written by the Admin SDK only, which bypasses rules;
        everything a user legitimately changes about themselves is listed here.
      */
      allow update: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['mustChangePassword', 'updatedAt', 'displayName', 'lastSeenAt', 'email', 'lastProjectTabs', 'attentionState']));
        /*
          There used to be a third branch here letting any non-client write
          their own `role`, so the studio sign-in could copy it from the team
          list. It also let them write "Super Admin", which isSuperAdmin()
          honours in every tenant. The copy is made by syncStudioAccess now.
        */

      allow delete: if isSuperAdmin();
    }

    match /organizations/{orgId} {
      /*
        The studio profile carries its team list -- names, emails, roles -- and
        was readable by anyone. Its members and its own clients read it; the
        portal link's sign-in door gets only the name and logo, through the
        portalDoor function.
      */
      allow read: if isAuthenticated() && (
          getUserData().get('tenantId', '') == orgId || isSuperAdmin()
      );
      /*
        A new studio is created by the platform owner. "Create it if it does
        not exist yet" let anyone mint a tenant and name themselves its team.

        The team list decides who syncStudioAccess lets in and as what, and
        projectDesigners decides which projects each Designer sees, so only a
        studio's senior roles may change either.
      */
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
          isSameTenant(orgId) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['team', 'projectDesigners']) ||
           getUserData().get('role', '') in ['Owner', 'Admin', 'Ops Director'])
      );
      allow delete: if isSuperAdmin();
      
      match /settings/{settingId} {
         allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin() || isTenantDesigner(orgId));
         allow write: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
            && (getUserData().role == 'Owner' || isSuperAdmin());
      }

      match /projects/{projectId} {
         match /boqItems/{itemId} {
           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           // No hard deletes
           allow delete: if false;

           allow update: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
             // Viewer check
             && (getUserData().role != 'Viewer')
             // Enforce append-only array for statusHistory
             && (!request.resource.data.keys().hasAll(['statusHistory']) || 
                 !resource.data.keys().hasAll(['statusHistory']) || 
                 request.resource.data.statusHistory.size() >= resource.data.statusHistory.size())
             // Designer logic check
             && (
                (getUserData().role == 'Designer' && request.resource.data.boqStatus != resource.data.boqStatus) 
                  ? (request.resource.data.boqStatus in ['included_ffds_scope', 'pending_finalisation', 'on_hold'])
                  : true // If not Designer, or not changing boqStatus, bypass
             );
         }

         match /boqVersions/{versionId} {
           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           // Creation is handled by Cloud Functions, but if we allow it from client:
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow update, delete: if false; // Immutable once created
         }

         match /bookingPacks/{packId} {
           /*
             Studio only. This was readable by anyone, and anyone could mark a
             pack approved, for a public approval page that no longer exists --
             nothing in the app renders /booking-approval/ any more.
           */
           allow read, create, update, delete: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
         }

         match /drawingTracker/{drawingId} {
           /* The Designer's one place to work: see isDesignerDrawingChange. */
           allow read: if isTenantDesigner(orgId);
           allow update: if isTenantDesigner(orgId) && isDesignerDrawingChange();
           match /revisions/{revisionId} {
             allow read, create: if isTenantDesigner(orgId);
           }

           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow delete: if false;
           allow update: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
             && (getUserData().role != 'Viewer')
             && (
               // Owner and Designer of the OWNING org may Issue GFC
               (request.resource.data.gfc.status == 'issued' && (!('gfc' in resource.data) || resource.data.gfc.status != 'issued'))
               ? (getUserData().role in ['Owner', 'Designer', 'Admin', 'Ops Director', 'Super Admin'] || isSuperAdmin() || isLegacyFFDS())
               : true
             );
         }

         match /drawingVersions/{versionId} {
           allow read: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
           allow create: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
             && (getUserData().role in ['Owner', 'Designer', 'Admin', 'Ops Director', 'Super Admin'] || isSuperAdmin() || isLegacyFFDS());
           allow update, delete: if false; // Immutability
         }

         /*
           A Designer reads the studio's copy of the project and its records --
           except the priced BOQ lines, BOQ versions and booking packs -- and
           writes none of it. Drawings are granted above.
         */
         allow read: if isTenantDesigner(orgId);
         match /{designerSub}/{designerDoc=**} {
           allow read: if isTenantDesigner(orgId) && !(designerSub in ['boqItems', 'boqVersions', 'bookingPacks']);
         }

         allow read, create, delete: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
         allow update: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin())
           && (getUserData().role != 'Viewer')
           && (
              (request.resource.data.executionData != null && 
               (!('executionData' in resource.data) || request.resource.data.executionData.bundles != resource.data.executionData.bundles))
              ? (getUserData().role in ['Owner', 'Admin', 'Ops Director', 'Super Admin'] || isSuperAdmin() || isLegacyFFDS())
              : true
           )
           && (
              (request.resource.data.engagement != resource.data.engagement)
              ? (getUserData().role == 'Owner' || isSuperAdmin())
              : true
           );
      }
      
      /*
        What a portal client reads beneath the studio's copy of their project.

        The portal listens to these two directly. It used to get through on the
        tenant check above, which a client passed for every project the studio
        had; this names the one project, from their own profile.
      */
      /*
        Only the meetings the client was part of.

        Internal and vendor meetings are the studio's own: their notes, MoMs
        and decisions were readable by the client straight from the database,
        hidden only by the portal screen's guess from the title. Now the rule
        decides, by the meeting's type. A meeting with no type, or any type
        not listed here, stays with the studio. The portal asks for these types
        by name -- a rule that reads the document cannot filter a query, so an
        open query is refused outright.
      */
      function isClientMeetingType(t) {
        return t in ['client_meeting', 'site_visit', 'measurement_survey', 'client'];
      }
      match /projects/{projectId}/siteVisits/{visitId} {
        allow read: if isProjectClient(orgId, projectId) &&
          isClientMeetingType(resource.data.get('type', ''));
      }
      match /projects/{projectId}/moms/{momId} {
        allow read: if isProjectClient(orgId, projectId) &&
          isClientMeetingType(resource.data.get('meetingType', ''));
        // From the portal a client may do one of two things to issued
        // minutes: acknowledge them (these four fields only), or ask for a
        // correction (the request and the status, nothing else). Neither on a
        // draft, and not while a correction they asked for is still open.
        allow update: if isProjectClient(orgId, projectId) &&
          isClientMeetingType(resource.data.get('meetingType', '')) &&
          resource.data.get('status', '') in ['finalised', 'shared'] && (
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'ackChannel']) &&
             request.resource.data.status == 'acknowledged') ||
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'correctionRequest']) &&
             request.resource.data.status == 'correction_requested' &&
             request.resource.data.correctionRequest.keys().hasOnly(['text', 'by', 'at']) &&
             request.resource.data.correctionRequest.text is string &&
             request.resource.data.correctionRequest.text.size() > 0 &&
             request.resource.data.correctionRequest.text.size() <= 2000)
          );
      }

    match /weeklyReports/{reportId} {
      allow read: if (isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin()))
                  || resource.data.status == 'published';
      allow create: if isAuthenticated() && (isSameTenant(request.resource.data.tenantId) || isSuperAdmin())
                    && (getUserData().role in ['Owner', 'Admin', 'Super Admin']);
      allow update: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin())
                    && (getUserData().role in ['Owner', 'Admin', 'Super Admin'])
                    && (
                      resource.data.status != 'published' || 
                      (request.resource.data.status == 'superseded' || request.resource.data.supersededBy != null)
                    );
      allow delete: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || isSuperAdmin())
                    && (getUserData().role in ['Owner', 'Admin', 'Super Admin'])
                    && resource.data.status != 'published';
    }

    /*
      Everything else beneath the studio, for its own staff.

      `{collectionId}` first, so this needs at least one segment below the
      studio. A bare `{document=**}` also matches zero segments in rules v2 --
      that is, organizations/{orgId} itself -- which quietly let every member,
      and every client, rewrite the studio profile and its team list whatever
      the rules above said.
    */
    match /{collectionId}/{document=**} {
         allow read, write: if isAuthenticated() && (isSameTenant(orgId) || isSuperAdmin());
      }
    }

    // ========================================================================
    // CORE COLLECTIONS (Tenant-Aware)
    // ========================================================================
    
    // PROJECTS: Main Project Data
    match /projects/{projectId} {
      /*
        This was `allow read: if true` -- every project of every studio, with
        its rates, margins, client contacts and internal notes, readable by
        anyone holding the public web config. Nothing needs that any more:
        clients read the stripped portalView below, and the portal link's
        sign-in door asks the portalDoor function for the studio's name.
      */
      allow read: if isAuthenticated() && (
        isSameTenant(resource.data.tenantId) ||
        (isLegacyFFDS() && !('tenantId' in resource.data)) ||
        isSuperAdmin() ||
        // A Designer reads the studio's projects and writes none of them.
        isTenantDesigner(resource.data.tenantId)
      );

      /*
        A Designer reads what hangs off a project, apart from the money: the
        priced tier BOQs, the engagement record, payment requests and margin
        analytics. The client-side subcollections have their own rules below.
      */
      match /{designerSub}/{designerDoc=**} {
        allow read: if isTenantDesigner(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId)
          && !(designerSub in ['tierBoq', 'engagement', 'paymentRequests', 'marginAnalytics']);
      }

      /*
        Writes belong to the studio that owns the project.

        The second clause here used to read:

          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['context', 'lastModified', 'isCompressed', 'compressedData']))

        with no authentication at all, so that a portal client could record a
        signature. But `context` is the entire project — every rate, every
        internal note, every unpublished draft, the portal access token — and
        `compressedData` is that same context as a blob. Anyone who knew a
        project id could replace all of it, and no narrower version of the rule
        was possible: security rules cannot see inside a compressed field.

        Client sign-offs, queries, disputes, document views and selection
        confirmations now go through the `submitClientAction` callable, which
        checks the caller's own users/{uid} record and applies one action from a
        closed set. The client never writes this document.
      */
      allow update: if isAuthenticated() && (isSameTenant(request.resource.data.tenantId) || isSuperAdmin());

      // CREATE: Document payload must match user's tenantId
      allow create: if isAuthenticated() && (isSameTenant(request.resource.data.tenantId) || isSuperAdmin());
      
      // DELETE: Can only delete if they had read access to it
      allow delete: if isAuthenticated() && (
        isSameTenant(resource.data.tenantId) ||
        (isLegacyFFDS() && !('tenantId' in resource.data)) ||
        isSuperAdmin()
      );

      /*
        PORTAL VIEW — the published, client-safe projection.

        This is what a signed-in client reads instead of the project document.
        buildPortalView has already stripped rates, margins, unpublished items
        and the access token, so what is not published is not merely hidden in
        the UI -- it is never sent. Access is by the reader's own profile:
        the project must be listed on their users/{uid}.projectIds.
      */
      match /portalView/{viewId} {
        allow read: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin() ||
          (projectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.projectIds)
        );
        allow write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin()
        );
      }

      /*
        BOQ line items for each version of the project's scope.

        Moved out of the project document because they are the bulk of it — on a
        live project, 443KB of a 699KB payload against Firestore's 1 MiB limit —
        and the save used to stay under that limit by deleting superseded
        versions outright.

        Studio-side only. This is the priced BOQ with the studio's own line
        detail; what a client may see goes through portalView, which carries
        sell rates and nothing behind them. A portal client's projectIds grant
        them nothing here, deliberately.
      */
      /*
        The engagement record: locked terms snapshot, payment structure, the
        agreement's own history. Moved out of the project document because it is
        the largest single field on it — 359KB on a live project against a 1 MiB
        limit — and a project that outgrows that limit stops syncing entirely.

        Studio-side only. A client reads their terms through portalView, which
        carries the slice the documents are rendered from and nothing else.
      */
      match /engagement/{docId} {
        allow read, write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin()
        );
      }

      match /tierBoq/{tierId} {
        allow read, write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          isSuperAdmin()
        );
      }

      match /selections/{selectionId} {
        allow read, write: if isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
          isSuperAdmin()
        );
      }

      // DECISIONS (Nested Collection)
      /*
        Studio-side project subcollections.

        Firestore rules do not cascade: `match /projects/{projectId}` granting
        read does nothing for the collections beneath it, and each of these had
        no match block of its own, so every read was denied. The app's own
        listeners pass no error callback, so the denial surfaced as a screen
        that says "Loading..." forever rather than as an error — the
        communication tracker was stuck on exactly that.

        Access follows the model already used by `decisions` and `tierBoq`
        below: the reader must be signed in and belong to the tenant that owns
        the parent project. These are internal operational records — comms
        logs, site visits, tasks, margin analytics — so unlike `portalView`
        there is no client-facing path and no unauthenticated branch.
      */
      function ownsParentProject() {
        return isAuthenticated() && (
          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
          isSuperAdmin()
        );
      }

      match /communicationLog/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /deliverables/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /designGate/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /journeySteps/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /liveFeed/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /marginAnalytics/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /moms/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /paymentRequests/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /scopeAdditions/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /siteVisits/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /stepProgress/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /tasks/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /timelinePhases/{docId} {
        allow read: if ownsParentProject();
        allow create, update: if ownsParentProject() && getUserData().role != 'Viewer';
        allow delete: if ownsParentProject() && getUserData().role != 'Viewer';
      }

      match /decisions/{decisionId} {
        allow read: if (isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        )) ||
                       isDecisionClient();

        /*
          The portal client approves or queries a decision on their own
          project (decisionsService.recordClientSignoff). That used to pass the
          tenant check above, because a client's profile carries the studio's
          tenantId; clients no longer pass it, so they are named here -- their
          project only, and only the three fields a response writes.
        */
        function isDecisionClient() {
          let u = getUserData();
          return isAuthenticated() && u.get('role', '') == 'Client'
            && projectId in u.get('projectIds', [])
            && u.get('tenantId', '') == get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId;
        }
        allow update: if isDecisionClient()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'discussion', 'signoff'])
          && request.resource.data.status in ['signed', 'disputed'];

        allow create: if isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        );

        allow update: if (isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        ));
        /*
          A signed-out branch used to sit on both read and update here, for the
          emailed decision sign-off page. That page was removed and decisions
          are answered in the portal, by isDecisionClient above.
        */

        allow delete: if isAuthenticated() && (
                          isSameTenant(get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId) ||
                          (isLegacyFFDS() && !('tenantId' in get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                          isSuperAdmin()
                        );
      }
    }

    // MULTI-TENANT MASTER DATA (Item Bank, Templates, Rate Library)
    // Legacy system used hardcoded names like 'item_bank'
    // New system uses 'item_bank_{tenantId}'
    match /master_data/{docId} {
      allow read, write: if isAuthenticated() && (
        (isLegacyFFDS() && (docId == 'item_bank' || docId == 'draft_item_bank' || docId == 'templates')) ||
        (docId == 'item_bank_' + getUserTenantId()) ||
        (docId == 'draft_item_bank_' + getUserTenantId()) ||
        (docId == 'templates_' + getUserTenantId()) ||
        isSuperAdmin()
      );
    }
    
    match /publicProposals/{tokenId} {
      allow read: if true;
    }

    match /studioSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() && (settingId == getUserTenantId() || isSuperAdmin());
    }

    match /studios/{studioId} {
      allow read: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
      allow write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
      
      match /settings/{docId} {
        allow read: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin() || isTenantDesigner(studioId));
        allow write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
      }
      match /projects/{projectId} {
         allow read: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
         allow write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
         match /{document=**} {
            allow read, write: if isAuthenticated() && (studioId == getUserTenantId() || isSuperAdmin());
         }
      }
    }

    // ========================================================================
    // FUTURE-READY COLLECTIONS (For upcoming modularization)
    // Preparing schema for boqItems, proposals, client_outputs, rate_library, execution_data
    // ========================================================================

    match /boqItems/{itemId} {
      allow read: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)));
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)));
    }

    match /proposals/{proposalId} {
      allow read: if isAuthenticated() && (isSameTenant(resource.data.tenantId) || (isLegacyFFDS() && !('tenantId' in resource.data)));
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId) && hasRole('editor');
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }

    match /client_outputs/{outputId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }

    match /rate_library/{rateId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId) && hasRole('admin');
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId) && hasRole('admin');
    }

    match /execution_data/{execId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isSameTenant(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && isSameTenant(resource.data.tenantId);
    }

    // ========================================================================
    // FALLBACK
    // ========================================================================

    // Catch-all to deny unspecified collections to prevent accidental data leaks
    match /{document=**} {
      allow read, write: if false; 
    }
    /*
      There was a collection-group rule here letting anyone read any decision
      with an unexpired sign-off token. A query that asked for exactly that --
      every decision whose token has not expired -- satisfied it, so the whole
      platform's open decisions could be listed without signing in. It served
      the standalone decision sign-off page, which was removed; decisions are
      approved in the portal, under the per-project rules above.
    */
  }
}
